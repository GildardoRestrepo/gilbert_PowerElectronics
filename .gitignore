# ============================================================
#  .gitignore — Electronics + 3D design project
# ============================================================

# ----- Operating system -----
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
# macOS
.DS_Store
.AppleDouble
._*
# Linux
*~
.Trash-*

# ----- Editors / IDEs -----
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.bak

# ----- CAD 3D (Fusion 360 / SolidWorks) -----
# Lock and backup files. Design files (.f3d / .sldprt / .sldasm / .slddrw) are NOT ignored
~$*
*~*.SLD*
*.SLDPRT.bak
*.SLDASM.bak
*.SLDDRW.bak
*.f3d.lock
*.lck
Backup/
backup/
Backups/
swxJRNL.*
# Heavy meshes/exports: uncomment if you do NOT want to version them
# *.stl
# *.step
# *.stp
# *.iges
# *.igs

# ----- Electronic design (backups / generic caches) -----
*-backups/
_autosave/
fp-info-cache
*.kicad_pcb-bak
*.sch-bak
*.000
*.b#*
History/
__Previews/
Project Logs*/

# ----- Firmware / source code -----
# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
# PlatformIO / Arduino
.pio/
.pioenvs/
.piolibdeps/
build/
*.elf
*.hex
*.bin
# Node
node_modules/

# ----- Miscellaneous -----
*.log
